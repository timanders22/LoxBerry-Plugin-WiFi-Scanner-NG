# --- Programme, die check.pl aufruft ---
# arp steckt in net-tools und ist auf Debian 12/13 NICHT mehr ab Werk
# installiert. Ohne das Paket faellt der Zwischenspeicher ueber die
# ARP-Tabelle aus und jede Suche geht ueber arp-scan - langsamer, und die
# Diagnose im Reiter Test meldet /usr/sbin/arp als fehlend.
net-tools
arping
arp-scan

# --- Perl-Module, die beide Skripte laden ---
# LWP::UserAgent (Fritz!Box ueber TR-064)
libwww-perl
# XML::Simple (Antwort der Fritz!Box)
libxml-simple-perl
# JSON (Zustandsabbild fuer die Oberflaeche, seit 3.1.12)
libjson-perl
# Net::MQTT::Simple
libnet-mqtt-simple-perl
# Data::Validate::IP (Adresspruefung)
libdata-validate-ip-perl
# Capture::Tiny (Ausgabe der Werkzeuge einfangen, ohne Shell)
libcapture-tiny-perl
# Config::Simple
libconfig-simple-perl

