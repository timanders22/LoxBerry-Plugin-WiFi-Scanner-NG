#!/bin/bash
# WifiScanner - uninstall
# command <TEMPFOLDER> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
#
# Wird von LoxBerry als root ausgefuehrt. Rueckgabewert 0 = in Ordnung,
# 1 = Warnung (die Deinstallation laeuft trotzdem weiter).
#
# ===================================================================
# WARUM ES DIESE DATEI GIBT
# ===================================================================
#
# LoxBerry raeumt die Plugin-Ordner weg und entfernt den Cron-Eintrag und
# die sudoers-Zeilen. Zwei Dinge bleiben sonst liegen:
#
#   1. Der MQTT-Listener. Er wird beim Hochfahren mit "nohup ... &"
#      gestartet und haengt an keinem Elternprozess, den LoxBerry beenden
#      wuerde - ohne dieses Skript liefe er bis zum naechsten Neustart
#      weiter und haenge weiter am Broker.
#   2. Die retained Themen im Broker. Das Plugin veroeffentlicht die
#      Anwesenheit MIT Retain-Merker, damit der Miniserver nach einem
#      Neustart sofort den letzten Stand hat. Genau das bedeutet aber:
#      der Broker haelt sie fest, bis sie jemand loescht.
#
# ZUR PROZESSSUCHE - bitte nicht auf pkill zurueckbauen:
# "pkill -f mqtt_listener.pl" durchsucht die ganze Befehlszeile und traefe
# auch einen Editor mit offener Datei oder ein zweites Exemplar des
# Plugins. "ps -C" und "killall" vergleichen den comm-Namen, der bei einem
# Skript mit Shebang "perl" lautet - die finden gar nichts.

PDIR=$3
[ -n "$PDIR" ] || PDIR="wifi_ng"
BASE="${5:-$LBHOMEDIR}"
# Dritter Rueckfall: vom eigenen Ablageort aufwaerts suchen. Bewusst kein
# fest verdrahteter Systempfad - LoxBerry laesst sich anderswohin
# installieren, und der Plugin-Pruefer sucht die Zeichenkette, ohne den
# Zusammenhang zu sehen. Der Installer legt dieses Skript als
# <home>/data/system/uninstall/<ordner> ab und uebergibt die LoxBerry-Wurzel
# als fuenftes Argument (plugininstall.pl:1158 und :1577, am Geraet
# nachgesehen 17.09.2026); dieser Zweig greift nur, wenn beides fehlt.
#
# Bis 3.2.7 stand hier eine feste Zahl von Ebenen ("../../.."), ohne jede
# Probe, ob dort ueberhaupt ein LoxBerry liegt. Gemessen am 18.09.2026 in
# WSL (Pruefung-WiFi-Scanner-NG-3.2.8/Pruefstaende/messe_welle2.sh, Fall H4):
# aus einem Pruefarchiv <ordner>/pruefung/<plugin>/uninstall/uninstall ohne
# Argumente aufgerufen, loeschte es <ordner>/config/plugins/wifi_ng.wifi_scanner.backup
# eines fremden Baums. Jetzt gilt nur ein Verzeichnis mit config/plugins,
# data/plugins UND config/system/general.json (Regeln/06: ein LoxBerry hat
# sie immer, ein Rest aus Pruefstaenden nie); ohne eine solche Wurzel wird
# gewarnt und nichts angefasst.
lb_wurzel_suchen() {
    v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd)
    i=0
    while [ -n "$v" ] && [ "$v" != "/" ] && [ $i -lt 8 ]; do
        if [ -d "$v/config/plugins" ] && [ -d "$v/data/plugins" ] \
                && [ -f "$v/config/system/general.json" ]; then
            echo "$v"; return 0
        fi
        v=$(dirname "$v"); i=$((i + 1))
    done
    return 1
}
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    BASE=$(lb_wurzel_suchen)
fi
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ]; then
    echo "<WARNING> Die LoxBerry-Wurzel ist unbekannt (kein fuenftes Argument, kein"
    echo "<WARNING> LBHOMEDIR, und oberhalb dieses Skripts liegt kein LoxBerry)."
    echo "<WARNING> Es wurde nichts beendet und nichts geloescht."
    exit 1
fi

SKRIPT="$BASE/bin/plugins/$PDIR/mqtt_listener.pl"

# argv[0] ist ein perl, argv[1] ist ZEICHENGENAU unser Pfad, und es gibt kein
# drittes Argument. Bis 3.2.6 wurden nur die ersten beiden Argumente gegen den
# Pfad gehalten, ohne zu fragen, WER die Datei in der Hand hat. Gemessen am
# 18.09.2026 in WSL (Pruefung-WiFi-Scanner-NG-3.2.7/Pruefstaende/messe_koeder.sh):
# ein Koeder "tail <listenerpfad> -f" - GNU tail vertauscht Option und
# Dateiname, der Pfad steht damit in argv[1] - wurde von der gleichlautenden
# Stelle in postupgrade.sh beendet (Fall K4). Dieses Skript laeuft als root.
ist_unser_listener() {
    [ -r "/proc/$1/cmdline" ] || return 1
    ws_n=0
    ws_treffer=0
    while IFS= read -r ws_arg; do
        ws_n=$((ws_n + 1))
        if [ "$ws_n" = 1 ]; then
            case "${ws_arg##*/}" in
                perl|perl5*) ;;
                *) return 1 ;;
            esac
        elif [ "$ws_n" = 2 ] && [ "$ws_arg" = "$SKRIPT" ]; then
            ws_treffer=1
        fi
    done <<WS_ARGUMENTE
$( { tr '\0' '\n' < "/proc/$1/cmdline"; } 2>/dev/null )
WS_ARGUMENTE
    [ "$ws_treffer" = 1 ] && [ "$ws_n" = 2 ]
}

GEFUNDEN=0
for D in /proc/[0-9]*; do
    P=$(basename "$D")
    if ist_unser_listener "$P" && kill -0 "$P" 2>/dev/null; then
        kill "$P" 2>/dev/null
        for i in 1 2 3 4 5; do
            kill -0 "$P" 2>/dev/null || break
            sleep 1
        done
        kill -9 "$P" 2>/dev/null
        GEFUNDEN=1
        echo "<OK> MQTT-Listener beendet (PID $P)."
    fi
done
[ "$GEFUNDEN" -eq 0 ] && echo "<INFO> Es lief kein MQTT-Listener."

echo "<WARNING> Im MQTT-Broker bleiben Werte stehen."
echo "<INFO> Das Plugin veroeffentlicht die Anwesenheit mit gesetztem"
echo "<INFO> Retain-Merker. Betroffen sind alle Themen unter"
echo "<INFO>     wifi_ng/..."
echo "<INFO> (je Person eine, dazu status/mode, status/interval,"
echo "<INFO> status/enabled). Zum Aufraeumen: LoxBerry -> System ->"
echo "<INFO> MQTT Gateway, dort die wifi_ng-Eintraege loeschen."
echo "<INFO> Wer das nicht tut, sieht in Loxone noch jahrelang die"
echo "<INFO> Anwesenheit vom Tag der Deinstallation."

# ---------------------------------------------------------------
# Die Sicherung ausserhalb des Plugin-Ordners
# ---------------------------------------------------------------
# ws_config_write() legt bei jedem Speichern eine Kopie NEBEN dem
# Konfigordner ab: config/plugins/<ordner>.wifi_scanner.backup. Sie
# liegt dort mit Absicht - so uebersteht sie eine Neuinstallation.
# Beim Deinstallieren ist das falsch: LoxBerry entfernt
# config/plugins/<ordner>/, also das VERZEICHNIS, und die Datei
# daneben bliebe dauerhaft liegen.
#
# Sie enthaelt zwar keine Passwoerter, aber die MAC-Adressen und
# Namen aller ueberwachten Personen - eine Anwesenheitsliste des
# Haushalts. Die gehoert nicht auf eine Karte, von der jemand
# glaubt, das Plugin sei entfernt.
#
# SEIT 3.1.12 steht in diesen Dateien zusaetzlich das Merkwort der Anlage
# und - wenn eingetragen - das Kennwort der Fritz!Box. Sie werden deshalb
# ueberschrieben, BEVOR sie geloescht werden. Das ist keine sichere
# Loeschung: auf einer SD-Karte mit Wear-Leveling und einem
# journalfuehrenden Dateisystem kann der alte Block liegen bleiben. Es
# erschwert das Wiederfinden, mehr wird hier nicht behauptet.
#
# ES SIND DREI DATEIEN, nicht eine. Bis 3.1.11 wurde nur die erste
# abgeraeumt; die beiden Zweitschriften aus preupgrade.sh blieben liegen -
# mit den Namen und MAC-Adressen aller ueberwachten Personen, also einer
# Anwesenheitsliste des Haushalts, auf einer Karte, von der jemand glaubt,
# das Plugin sei entfernt.
WEG=0
for BK in "$BASE/config/plugins/$PDIR.wifi_scanner.backup" \
          "$BASE/config/plugins/$PDIR.backup.wifi_scanner.cfg" \
          "$BASE/config/plugins/$PDIR.backup.mqtt_subscriptions.cfg"; do
    if [ -f "$BK" ]; then
        dd if=/dev/zero of="$BK" bs=1024 count=8 conv=notrunc 2>/dev/null
        if rm -f "$BK"; then
            WEG=$((WEG + 1))
            echo "<OK> Sicherung ueberschrieben und entfernt: $(basename "$BK")"
        else
            echo "<WARNING> $(basename "$BK") liess sich nicht entfernen."
        fi
    fi
done
# Nachzaehlen statt melden: eine Erfolgsmeldung, die niemand geprueft hat,
# ist eine Behauptung.
UEBRIG=0
for BK in "$BASE/config/plugins/$PDIR.wifi_scanner.backup" \
          "$BASE/config/plugins/$PDIR.backup.wifi_scanner.cfg" \
          "$BASE/config/plugins/$PDIR.backup.mqtt_subscriptions.cfg"; do
    [ -f "$BK" ] && UEBRIG=$((UEBRIG + 1))
done
if [ "$UEBRIG" -gt 0 ]; then
    echo "<WARNING> $UEBRIG Sicherungsdatei(en) liegen noch unter"
    echo "<WARNING> $BASE/config/plugins/ und muessen von Hand entfernt werden."
elif [ "$WEG" -eq 0 ]; then
    echo "<INFO> Es lagen keine Sicherungsdateien neben dem Konfigordner."
fi

# Seit 3.2.8 entstehen die Zweitschriften unteilbar: erst eine Nebendatei,
# dann umbenennen (preupgrade.sh: <datei>.neu; ws_config_write():
# <ordner>.wifi_scanner.backup.tmp.<pid>). Bricht ein Lauf genau dazwischen
# ab, bleibt die Nebendatei liegen - mit demselben Inhalt wie die
# Zweitschrift. Sie geht hier denselben Weg.
for BK in "$BASE/config/plugins/$PDIR.backup.wifi_scanner.cfg.neu" \
          "$BASE/config/plugins/$PDIR.backup.mqtt_subscriptions.cfg.neu" \
          "$BASE/config/plugins/$PDIR.wifi_scanner.backup.tmp."*; do
    [ -f "$BK" ] || continue
    dd if=/dev/zero of="$BK" bs=1024 count=8 conv=notrunc 2>/dev/null
    if rm -f "$BK"; then
        echo "<OK> Liegengebliebene Nebendatei entfernt: $(basename "$BK")"
    else
        echo "<WARNING> $(basename "$BK") liess sich nicht entfernen."
    fi
done


# ---------- Den Nachbarn der Sicherung wegraeumen ----------
# data/plugins/<ordner>.upgrade_sicherung liegt AUSSERHALB des Ordners, den
# LoxBerry beim Deinstallieren loescht - genau deshalb uebersteht er ein
# Update. Wer ihn hier nicht abraeumt, laesst Zugangsdaten liegen.
UN_FOLDER="${3:-}"
UN_BASE="${5:-$LBHOMEDIR}"
if [ -n "$UN_FOLDER" ] && [ -n "$UN_BASE" ] && [ -d "$UN_BASE/data/plugins" ]; then
    # .neu und .alt sind die Zwischenstaende des unteilbaren Sicherns in
    # preupgrade.sh (seit 3.2.8); nach einem Abbruch tragen sie denselben
    # Inhalt wie die Sicherung.
    rm -rf "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung" \
           "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung.neu" \
           "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung.alt" 2>/dev/null
fi

# ---------- Die Marke der Aktualisierung ----------
# Sie liegt ebenfalls NEBEN dem Datenordner und uebersteht deshalb, was
# LoxBerry beim Deinstallieren wegraeumt. Bliebe sie liegen, sperrte sie eine
# spaetere Neuinstallation dieses Plugins bis zu einer Stunde lang - der
# Listener startete nicht, und die Oberflaeche zeigte nur den Hinweis.
# $PDIR und $BASE stehen hier bewusst statt $UN_FOLDER/$UN_BASE: sie tragen
# die Rueckfaelle vom Kopf dieser Datei.
rm -f "$BASE/data/plugins/$PDIR.upgrade_laeuft" 2>/dev/null
exit 0
