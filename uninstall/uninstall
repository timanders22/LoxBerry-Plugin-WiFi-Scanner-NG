#!/bin/bash
# WifiScanner - uninstall
# command <TEMPFOLDER> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
#
# Wird von LoxBerry als root ausgefuehrt. Rueckgabewert 0 = in Ordnung,
# 1 = Warnung (die Deinstallation laeuft trotzdem weiter).
#
# ===================================================================
# WARUM ES DIESE DATEI GIBT
# ===================================================================
#
# LoxBerry raeumt die Plugin-Ordner weg und entfernt den Cron-Eintrag und
# die sudoers-Zeilen. Zwei Dinge bleiben sonst liegen:
#
#   1. Die Dauerprozesse: seit 3.2.15 die Befehlsbruecke und der Haus-Abnehmer
#      (V3), bis 3.2.14 der MQTT-Listener (fuer abgebrochene Updates wird er
#      weiter gesucht). Sie haengen an keinem Elternprozess, den LoxBerry beenden
#      wuerde.
#   2. Die retained Themen im Broker. Das Plugin veroeffentlicht die
#      Anwesenheit MIT Retain-Merker, damit der Miniserver nach einem
#      Neustart sofort den letzten Stand hat. Genau das bedeutet aber:
#      der Broker haelt sie fest, bis sie jemand loescht.
#
# ZUR PROZESSSUCHE - bitte nicht auf pkill zurueckbauen:
# "pkill -f mqtt_listener.pl" durchsucht die ganze Befehlszeile und traefe
# auch einen Editor mit offener Datei oder ein zweites Exemplar des
# Plugins. "ps -C" und "killall" vergleichen den comm-Namen, der bei einem
# Skript mit Shebang "perl" lautet - die finden gar nichts.

PDIR=$3
[ -n "$PDIR" ] || PDIR="wifi_ng"
# Praefixschutz (Hausregel Gruppe 4: das uninstall von zigbee2mqtt riss zigbee2mqttng mit): nur der EIGENE Ordner,
# kein Name mit Pfadtrenner, und unten nirgends ein Muster "$PDIR*" - jeder Pfad ist ausgeschrieben.
case "$PDIR" in
    */*|*..*) echo "<WARNING> Unzulaessiger Ordnername '$PDIR' - nichts angefasst."; exit 1 ;;
esac
BASE="${5:-$LBHOMEDIR}"
# Dritter Rueckfall: vom eigenen Ablageort aufwaerts suchen. Bewusst kein
# fest verdrahteter Systempfad - LoxBerry laesst sich anderswohin
# installieren, und der Plugin-Pruefer sucht die Zeichenkette, ohne den
# Zusammenhang zu sehen. Der Installer legt dieses Skript als
# <home>/data/system/uninstall/<ordner> ab und uebergibt die LoxBerry-Wurzel
# als fuenftes Argument (plugininstall.pl:1158 und :1577, am Geraet
# nachgesehen 17.09.2026); dieser Zweig greift nur, wenn beides fehlt.
#
# Bis 3.2.7 stand hier eine feste Zahl von Ebenen ("../../.."), ohne jede
# Probe, ob dort ueberhaupt ein LoxBerry liegt. Gemessen am 18.09.2026 in
# WSL (Pruefung-WiFi-Scanner-NG-3.2.8/Pruefstaende/messe_welle2.sh, Fall H4):
# aus einem Pruefarchiv <ordner>/pruefung/<plugin>/uninstall/uninstall ohne
# Argumente aufgerufen, loeschte es <ordner>/config/plugins/wifi_ng.wifi_scanner.backup
# eines fremden Baums. Jetzt gilt nur ein Verzeichnis mit config/plugins,
# data/plugins UND config/system/general.json (Regeln/06: ein LoxBerry hat
# sie immer, ein Rest aus Pruefstaenden nie); ohne eine solche Wurzel wird
# gewarnt und nichts angefasst.
lb_wurzel_suchen() {
    v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd)
    i=0
    while [ -n "$v" ] && [ "$v" != "/" ] && [ $i -lt 8 ]; do
        if [ -d "$v/config/plugins" ] && [ -d "$v/data/plugins" ] \
                && [ -f "$v/config/system/general.json" ]; then
            echo "$v"; return 0
        fi
        v=$(dirname "$v"); i=$((i + 1))
    done
    return 1
}
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    BASE=$(lb_wurzel_suchen)
fi
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ]; then
    echo "<WARNING> Die LoxBerry-Wurzel ist unbekannt (kein fuenftes Argument, kein"
    echo "<WARNING> LBHOMEDIR, und oberhalb dieses Skripts liegt kein LoxBerry)."
    echo "<WARNING> Es wurde nichts beendet und nichts geloescht."
    exit 1
fi

SKRIPT="$BASE/bin/plugins/$PDIR/mqtt_listener.pl"

# argv[0] ist ein perl, argv[1] ist ZEICHENGENAU unser Pfad, und es gibt kein
# drittes Argument. Bis 3.2.6 wurden nur die ersten beiden Argumente gegen den
# Pfad gehalten, ohne zu fragen, WER die Datei in der Hand hat. Gemessen am
# 18.09.2026 in WSL (Pruefung-WiFi-Scanner-NG-3.2.7/Pruefstaende/messe_koeder.sh):
# ein Koeder "tail <listenerpfad> -f" - GNU tail vertauscht Option und
# Dateiname, der Pfad steht damit in argv[1] - wurde von der gleichlautenden
# Stelle in postupgrade.sh beendet (Fall K4). Dieses Skript laeuft als root.
ist_unser_listener() {
    [ -r "/proc/$1/cmdline" ] || return 1
    ws_n=0
    ws_treffer=0
    while IFS= read -r ws_arg; do
        ws_n=$((ws_n + 1))
        if [ "$ws_n" = 1 ]; then
            case "${ws_arg##*/}" in
                perl|perl5*) ;;
                *) return 1 ;;
            esac
        elif [ "$ws_n" = 2 ] && [ "$ws_arg" = "$SKRIPT" ]; then
            ws_treffer=1
        fi
    done <<WS_ARGUMENTE
$( { tr '\0' '\n' < "/proc/$1/cmdline"; } 2>/dev/null )
WS_ARGUMENTE
    [ "$ws_treffer" = 1 ] && [ "$ws_n" = 2 ]
}

# ---------- Befehlsbruecke und Haus-Abnehmer (seit 3.2.15, Gruppe 14; Bauart BLE-Scanner NG 1.3.28) ----------
# Erst <dienst>.sh stop, dann nachzaehlen: ein Dienst dieses Ordners (php, genau zwei Argumente, argv[1] der eigene
# Pfad) und ein mosquitto_sub mit der eigenen Optionsdatei werden hart beendet. Die Optionsdateien tragen das
# Broker-Kennwort - vor dem Loeschen ueberschreiben, dann den Ordner entfernen. Im Broker bleibt nichts: Quittungen und
# status/befehle sind nie retained, und der Haus-Abnehmer schreibt nichts unter haus/.
UN_PBIN="$BASE/bin/plugins/$PDIR"
UN_PBIN_P=$(cd "$UN_PBIN" 2>/dev/null && pwd -P)
ws_dienst_raeumen() {   # ws_dienst_raeumen <sh> <php> <datenordner> <name>
    ws_sh="$UN_PBIN/$1"; ws_php="$UN_PBIN/$2"; ws_dd="$BASE/data/plugins/$PDIR/$3"
    if [ -f "$ws_sh" ] && command -v bash >/dev/null 2>&1; then
        echo "<INFO> $4: $(timeout 40 bash "$ws_sh" stop 2>&1 9>&- | head -n 1)"
    fi
    ws_rest=0
    for ws_d in /proc/[0-9]*; do
        grep -qaF "$2" "$ws_d/cmdline" 2>/dev/null || continue
        ws_a0=$(tr '\0' '\n' < "$ws_d/cmdline" 2>/dev/null | sed -n 1p)
        ws_a1=$(tr '\0' '\n' < "$ws_d/cmdline" 2>/dev/null | sed -n 2p)
        ws_n=$(tr '\0' '\n' < "$ws_d/cmdline" 2>/dev/null | grep -c '')
        case "${ws_a0##*/}" in php|php[0-9]*) ;; *) continue ;; esac
        if [ "$ws_n" = 2 ] && { [ "$ws_a1" = "$ws_php" ] || { [ -n "$UN_PBIN_P" ] && [ "$ws_a1" = "$UN_PBIN_P/$2" ]; }; }; then
            kill -9 "${ws_d#/proc/}" 2>/dev/null && ws_rest=$((ws_rest + 1))
        fi
    done
    ws_abos=0
    for ws_d in /proc/[0-9]*; do
        [ "$(cat "$ws_d/comm" 2>/dev/null)" = "mosquitto_sub" ] || continue
        if tr '\0' '\n' < "$ws_d/environ" 2>/dev/null | grep -qxF "XDG_CONFIG_HOME=$ws_dd/mosquitto"; then
            kill -9 "${ws_d#/proc/}" 2>/dev/null && ws_abos=$((ws_abos + 1))
        fi
    done
    [ "$ws_rest" -gt 0 ] && echo "<WARNING> $4: $ws_rest Dienst(e) erst mit kill -9 beendet."
    [ "$ws_abos" -gt 0 ] && echo "<WARNING> $4: $ws_abos mosquitto_sub erst mit kill -9 beendet."
    if [ -d "$ws_dd" ] && [ ! -L "$ws_dd" ]; then
        for ws_f in "$ws_dd/mosquitto/mosquitto_sub" "$ws_dd/mosquitto/mosquitto_pub"; do
            if [ -f "$ws_f" ] && [ ! -L "$ws_f" ]; then
                ws_g=$(stat -c %s "$ws_f" 2>/dev/null || echo 64)
                head -c "$ws_g" /dev/zero > "$ws_f" 2>/dev/null
            fi
        done
        # Praefixschutz: nur genau der eigene Unterordner befehle/ bzw. haus/.
        case "$ws_dd" in
            */data/plugins/"$PDIR"/befehle|*/data/plugins/"$PDIR"/haus) rm -rf "${ws_dd:?}" ;;
        esac
    fi
    if [ -e "$ws_dd/mosquitto/mosquitto_sub" ] || [ -e "$ws_dd/mosquitto/mosquitto_pub" ]; then
        echo "<WARNING> $4: Optionsdateien liegen noch unter $ws_dd/mosquitto - von Hand entfernen."
    fi
}
ws_dienst_raeumen befehlsbruecke.sh befehlsbruecke.php befehle Befehlsbruecke
ws_dienst_raeumen ws_haus.sh ws_haus.php haus Haus-Abnehmer

GEFUNDEN=0
for D in /proc/[0-9]*; do
    P=$(basename "$D")
    if ist_unser_listener "$P" && kill -0 "$P" 2>/dev/null; then
        kill "$P" 2>/dev/null
        for i in 1 2 3 4 5; do
            kill -0 "$P" 2>/dev/null || break
            sleep 1
        done
        kill -9 "$P" 2>/dev/null
        GEFUNDEN=1
        echo "<OK> MQTT-Listener beendet (PID $P)."
    fi
done
[ "$GEFUNDEN" -eq 0 ] && echo "<INFO> Es lief kein MQTT-Listener (der Vorfassung)."

# ---------------------------------------------------------------
# I3 (Durchgang 02.10.2026): der Zeitplan-Verweis heisst wifi_scanner, nicht
# wie der Plugin-Name - LoxBerry entfernt beim Deinstallieren nur
# cron.*/<name>. Bis 3.2.9 blieb er mit totem Ziel liegen und loeste nach
# einer Neuinstallation wieder auf (Installer-Pruefer Nr. 3, Fall N2).
# Entfernt wird nur ein Verweis, der auf check.pl DIESES Ordners zeigt.
# ---------------------------------------------------------------
for C in cron.01min cron.03min cron.05min cron.10min cron.15min cron.30min cron.hourly; do
    V="$BASE/system/cron/$C/wifi_scanner"
    [ -L "$V" ] || continue
    Z=$(readlink "$V" 2>/dev/null)
    if [ "$Z" = "$BASE/bin/plugins/$PDIR/check.pl" ]; then
        rm -f "$V" && echo "<OK> Zeitplan-Verweis entfernt: $C/wifi_scanner"
    else
        echo "<INFO> $C/wifi_scanner zeigt auf $Z - nicht dieses Plugin, bleibt liegen."
    fi
done

# ---------------------------------------------------------------
# I6 (Durchgang 02.10.2026, Entscheidungen 3 und 26): die zurueckbehaltenen
# Themen unter wifi_ng/ werden geleert, mit Nachlesen beim Broker
# (bin/mqtt_abraeumen.pl). Bis 3.2.9 stand hier nur der Hinweis, sie von
# Hand zu loeschen; in Loxone stand danach die Anwesenheit vom Tag der
# Deinstallation. VOR allem anderen: LoxBerry entfernt bin/plugins/<ordner>/
# erst nach diesem Skript.
# ---------------------------------------------------------------
# W19 (Gruppe 14): timeout -k 5 (ein Programm, das SIGTERM nicht annimmt, hielte sonst an - Muster BLE) und als
# loxberry statt root: der Helfer liegt im loxberry-schreibbaren bin/plugins/<ordner>/. Pfade aus der
# Wurzelpruefung oben, kein Wert aus der Konfiguration. --leeren-alle erfasst alle retained Themen unter wifi_ng/
# (Personen, mode/interval/enabled, die Altlast status/listener); status/befehle und Quittungen sind nie retained.
HELFER="$BASE/bin/plugins/$PDIR/mqtt_abraeumen.pl"
if [ -f "$HELFER" ] && command -v perl >/dev/null 2>&1; then
    if command -v timeout >/dev/null 2>&1; then BEGRENZT="timeout -k 5 90"; else BEGRENZT=""; fi
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        AUS=$(su -s /bin/sh loxberry -c "exec $BEGRENZT perl -I '$BASE/libs/perllib' '$HELFER' --leeren-alle" < /dev/null 2>&1)
    else
        AUS=$($BEGRENZT perl -I "$BASE/libs/perllib" "$HELFER" --leeren-alle < /dev/null 2>&1)
    fi
    RC=$?
    printf '%s\n' "$AUS" | sed -n '/^\(GEFUNDEN\|ERGEBNIS\|OFFEN\|KEIN\)/s/^/<INFO> MQTT: /p'
    case "$RC" in
        0) echo "<OK> Zurueckbehaltene MQTT-Themen unter wifi_ng/ geleert, beim Broker nachgelesen." ;;
        124|137) echo "<WARNING> Das Leeren der zurueckbehaltenen Themen wurde nach 90 s abgebrochen (Rueckgabe $RC)."
           echo "<WARNING> LoxBerry -> System -> MQTT Gateway, dort die Reste unter wifi_ng/ loeschen." ;;
        2) echo "<INFO> Der MQTT-Broker war nicht befragbar - falls noch Themen unter wifi_ng/"
           echo "<INFO> zurueckbehalten liegen: LoxBerry -> System -> MQTT Gateway, dort loeschen." ;;
        *) echo "<WARNING> Nicht alle zurueckbehaltenen Themen unter wifi_ng/ liessen sich leeren"
           echo "<WARNING> (Rueckgabe $RC). LoxBerry -> System -> MQTT Gateway, dort die Reste loeschen." ;;
    esac
else
    echo "<INFO> $HELFER oder perl fehlt - zurueckbehaltene MQTT-Themen wurden nicht geleert."
fi

# ---------------------------------------------------------------
# Die Sicherung ausserhalb des Plugin-Ordners
# ---------------------------------------------------------------
# ws_config_write() legt bei jedem Speichern eine Kopie NEBEN dem
# Konfigordner ab: config/plugins/<ordner>.wifi_scanner.backup. Sie
# liegt dort mit Absicht - so uebersteht sie eine Neuinstallation.
# Beim Deinstallieren ist das falsch: LoxBerry entfernt
# config/plugins/<ordner>/, also das VERZEICHNIS, und die Datei
# daneben bliebe dauerhaft liegen.
#
# Sie enthaelt zwar keine Passwoerter, aber die MAC-Adressen und
# Namen aller ueberwachten Personen - eine Anwesenheitsliste des
# Haushalts. Die gehoert nicht auf eine Karte, von der jemand
# glaubt, das Plugin sei entfernt.
#
# SEIT 3.1.12 steht in diesen Dateien zusaetzlich das Merkwort der Anlage
# und - wenn eingetragen - das Kennwort der Fritz!Box. Sie werden deshalb
# ueberschrieben, BEVOR sie geloescht werden. Das ist keine sichere
# Loeschung: auf einer SD-Karte mit Wear-Leveling und einem
# journalfuehrenden Dateisystem kann der alte Block liegen bleiben. Es
# erschwert das Wiederfinden, mehr wird hier nicht behauptet.
#
# ES SIND DREI DATEIEN, nicht eine. Bis 3.1.11 wurde nur die erste
# abgeraeumt; die beiden Zweitschriften aus preupgrade.sh blieben liegen -
# mit den Namen und MAC-Adressen aller ueberwachten Personen, also einer
# Anwesenheitsliste des Haushalts, auf einer Karte, von der jemand glaubt,
# das Plugin sei entfernt.
WEG=0
# I1 (Durchgang 02.10.2026): dazu die .alt, die preinstall.sh bei einer
# Neuinstallation beiseitelegt - sie tragen dasselbe wie die Zweitschriften.
for BK in "$BASE/config/plugins/$PDIR.wifi_scanner.backup" \
          "$BASE/config/plugins/$PDIR.backup.wifi_scanner.cfg" \
          "$BASE/config/plugins/$PDIR.backup.mqtt_subscriptions.cfg" \
          "$BASE/config/plugins/$PDIR.wifi_scanner.backup.alt" \
          "$BASE/config/plugins/$PDIR.backup.wifi_scanner.cfg.alt" \
          "$BASE/config/plugins/$PDIR.backup.mqtt_subscriptions.cfg.alt"; do
    if [ -f "$BK" ]; then
        dd if=/dev/zero of="$BK" bs=1024 count=8 conv=notrunc 2>/dev/null
        if rm -f "$BK"; then
            WEG=$((WEG + 1))
            echo "<OK> Sicherung ueberschrieben und entfernt: $(basename "$BK")"
        else
            echo "<WARNING> $(basename "$BK") liess sich nicht entfernen."
        fi
    fi
done
# Nachzaehlen statt melden: eine Erfolgsmeldung, die niemand geprueft hat,
# ist eine Behauptung.
UEBRIG=0
for BK in "$BASE/config/plugins/$PDIR.wifi_scanner.backup" \
          "$BASE/config/plugins/$PDIR.backup.wifi_scanner.cfg" \
          "$BASE/config/plugins/$PDIR.backup.mqtt_subscriptions.cfg" \
          "$BASE/config/plugins/$PDIR.wifi_scanner.backup.alt" \
          "$BASE/config/plugins/$PDIR.backup.wifi_scanner.cfg.alt" \
          "$BASE/config/plugins/$PDIR.backup.mqtt_subscriptions.cfg.alt"; do
    [ -f "$BK" ] && UEBRIG=$((UEBRIG + 1))
done
if [ "$UEBRIG" -gt 0 ]; then
    echo "<WARNING> $UEBRIG Sicherungsdatei(en) liegen noch unter"
    echo "<WARNING> $BASE/config/plugins/ und muessen von Hand entfernt werden."
elif [ "$WEG" -eq 0 ]; then
    echo "<INFO> Es lagen keine Sicherungsdateien neben dem Konfigordner."
fi

# Seit 3.2.8 entstehen die Zweitschriften unteilbar: erst eine Nebendatei,
# dann umbenennen (preupgrade.sh: <datei>.neu; ws_config_write():
# <ordner>.wifi_scanner.backup.tmp.<pid>). Bricht ein Lauf genau dazwischen
# ab, bleibt die Nebendatei liegen - mit demselben Inhalt wie die
# Zweitschrift. Sie geht hier denselben Weg.
for BK in "$BASE/config/plugins/$PDIR.backup.wifi_scanner.cfg.neu" \
          "$BASE/config/plugins/$PDIR.backup.mqtt_subscriptions.cfg.neu" \
          "$BASE/config/plugins/$PDIR.wifi_scanner.backup.tmp."*; do
    [ -f "$BK" ] || continue
    dd if=/dev/zero of="$BK" bs=1024 count=8 conv=notrunc 2>/dev/null
    if rm -f "$BK"; then
        echo "<OK> Liegengebliebene Nebendatei entfernt: $(basename "$BK")"
    else
        echo "<WARNING> $(basename "$BK") liess sich nicht entfernen."
    fi
done


# ---------- Den Nachbarn der Sicherung wegraeumen ----------
# data/plugins/<ordner>.upgrade_sicherung liegt AUSSERHALB des Ordners, den
# LoxBerry beim Deinstallieren loescht - genau deshalb uebersteht er ein
# Update. Wer ihn hier nicht abraeumt, laesst Zugangsdaten liegen.
# W18 (Gruppe 14): $PDIR und $BASE mit den Rueckfaellen vom Kopf (wifi_ng, lb_wurzel_suchen) statt $3/$5 allein -
# bis 3.2.14 blieb im Rueckfall die Sicherung (mit Fritz!Box-Kennwort) liegen. Dieselbe Begruendung wie unten fuer
# die Marke.
if [ -d "$BASE/data/plugins" ]; then
    # .neu und .alt sind die Zwischenstaende des unteilbaren Sicherns in
    # preupgrade.sh (seit 3.2.8); nach einem Abbruch tragen sie denselben
    # Inhalt wie die Sicherung.
    rm -rf "$BASE/data/plugins/$PDIR.upgrade_sicherung" \
           "$BASE/data/plugins/$PDIR.upgrade_sicherung.neu" \
           "$BASE/data/plugins/$PDIR.upgrade_sicherung.alt" 2>/dev/null
fi

# ---------- Die Marke der Aktualisierung ----------
# Sie liegt ebenfalls NEBEN dem Datenordner und uebersteht deshalb, was
# LoxBerry beim Deinstallieren wegraeumt. Bliebe sie liegen, sperrte sie eine
# spaetere Neuinstallation dieses Plugins bis zu einer Stunde lang - der
# Listener startete nicht, und die Oberflaeche zeigte nur den Hinweis.
# $PDIR und $BASE tragen die Rueckfaelle vom Kopf dieser Datei (seit 3.2.15
# auch fuer die Sicherung oben, W18).
rm -f "$BASE/data/plugins/$PDIR.upgrade_laeuft" 2>/dev/null

# I4 (Durchgang 02.10.2026): die beiden Sperrdateien des Listeners liegen
# ebenfalls neben dem Datenordner.
rm -f "$BASE/data/plugins/$PDIR.listener.lock" "$BASE/data/plugins/$PDIR.listener_start.lock" 2>/dev/null
exit 0
